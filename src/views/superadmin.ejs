<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=5">
    <link rel="stylesheet" href="/css/superadmin.css">
    <script src="/js/theme-toggle.js"></script>
</head>
<body class="admin-body">
    <!-- Header -->
    <header class="admin-header">
        <div class="header-left">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="background: rgba(255,255,255,0.15); padding: 8px 12px; border-radius: 8px; font-size: 1.2rem;">👑</div>
                <div>
                    <h1 style="margin: 0; font-size: 1.2rem; color: white;">WaBot SaaS — Panel Admin</h1>
                    <span style="color: rgba(255,255,255,0.7); font-size: 0.8rem;">Gestión de la plataforma</span>
                </div>
            </div>
        </div>
        <div class="header-right">
            <span style="color: rgba(255,255,255,0.8); font-size: 0.9rem;"><%= user.name %></span>
            <a href="/dashboard" style="color: rgba(255,255,255,0.7); text-decoration: none; font-size: 0.9rem;">Dashboard</a>
            <button id="themeToggleBtn" style="background: transparent; border: none; cursor: pointer; font-size: 1.15rem; color: white; padding: 4px 8px;" title="Cambiar Tema">🌙</button>
            <a href="/logout" style="color: rgba(255,255,255,0.7); text-decoration: none;">Salir</a>
        </div>
    </header>

    <main class="admin-main" style="max-width: 1400px; margin: 0 auto; padding: 24px;">
        <!-- Tabs -->
        <div class="admin-tabs">
            <button class="tab-btn active" data-tab="dashboard" onclick="switchSuperAdminTab('dashboard')">📊 Dashboard</button>
            <button class="tab-btn" data-tab="tenants" onclick="switchSuperAdminTab('tenants')">🏪 Tenants</button>
            <button class="tab-btn" data-tab="users" onclick="switchSuperAdminTab('users')">👥 Usuarios</button>
            <button class="tab-btn" data-tab="plans" onclick="switchSuperAdminTab('plans')">💰 Planes</button>
            <button class="tab-btn" data-tab="ai-agents" onclick="switchSuperAdminTab('ai-agents')">🧠 Agentes IA</button>
            <button class="tab-btn" data-tab="whatsapp" onclick="switchSuperAdminTab('whatsapp')">📱 WhatsApp</button>
            <button class="tab-btn" data-tab="db-connections" onclick="switchSuperAdminTab('db-connections')">🗄️ BD Externas</button>
            <button class="tab-btn" data-tab="audit" onclick="switchSuperAdminTab('audit')">📋 Auditoría</button>
        </div>

        <!-- Tab: Dashboard -->
        <section class="tab-content active" id="tab-dashboard">
            <div id="dashboardContent">
                <div style="text-align: center; padding: 40px; color: var(--text-secondary);">Cargando métricas...</div>
            </div>
        </section>

        <!-- Tab: Tenants -->
        <section class="tab-content" id="tab-tenants">
            <div class="form-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h3 style="margin: 0;">🏪 Gestión de Tenants</h3>
                    <span id="tenantCount" style="color: var(--text-secondary);"></span>
                </div>
                <div id="tenantsList">
                    <div style="text-align: center; padding: 40px; color: var(--text-secondary);">Cargando tenants...</div>
                </div>
            </div>
        </section>

        <!-- Tab: Usuarios -->
        <section class="tab-content" id="tab-users">
            <div class="form-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h3 style="margin: 0;">👥 Gestión de Usuarios</h3>
                    <button class="btn-primary" onclick="showCreateUserModal()">+ Nuevo Usuario</button>
                </div>
                <div id="usersList">
                    <div style="text-align: center; padding: 40px; color: var(--text-secondary);">Cargando usuarios...</div>
                </div>
            </div>
        </section>

        <!-- Tab: Planes -->
        <section class="tab-content" id="tab-plans">
            <div class="form-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h3 style="margin: 0;">💰 Planes & Pricing</h3>
                    <button class="btn-primary" onclick="showCreatePlanModal()">+ Nuevo Plan</button>
                </div>
                <div id="plansList">
                    <div style="text-align: center; padding: 40px; color: var(--text-secondary);">Cargando planes...</div>
                </div>
            </div>
        </section>

        <!-- Tab: Agentes IA -->
        <section class="tab-content" id="tab-ai-agents">
            <div class="form-card">
                <h3 style="margin: 0 0 16px 0;">🧠 Estado de Agentes IA</h3>
                <div id="aiStatusList">
                    <div style="text-align: center; padding: 40px; color: var(--text-secondary);">Cargando estado IA...</div>
                </div>
            </div>
        </section>

        <!-- Tab: WhatsApp -->
        <section class="tab-content" id="tab-whatsapp">
            <div class="form-card">
                <h3 style="margin: 0 0 16px 0;">📱 Estado de WhatsApp</h3>
                <div id="whatsappStatusList">
                    <div style="text-align: center; padding: 40px; color: var(--text-secondary);">Cargando estado WhatsApp...</div>
                </div>
            </div>
        </section>

        <!-- Tab: BD Externas -->
        <section class="tab-content" id="tab-db-connections">
            <div class="form-card">
                <h3 style="margin: 0 0 16px 0;">🗄️ Conexiones de BD Externas</h3>
                <div id="dbConnectionsList">
                    <div style="text-align: center; padding: 40px; color: var(--text-secondary);">Cargando conexiones...</div>
                </div>
            </div>
        </section>

        <!-- Tab: Auditoría -->
        <section class="tab-content" id="tab-audit">
            <div class="form-card">
                <h3 style="margin: 0 0 16px 0;">📋 Log de Auditoría</h3>
                <div id="auditLogList">
                    <div style="text-align: center; padding: 40px; color: var(--text-secondary);">Cargando auditoría...</div>
                </div>
                <div id="auditPagination" style="display: flex; justify-content: center; gap: 8px; margin-top: 16px;"></div>
            </div>
        </section>
    </main>

    <!-- Modal Container -->
    <div id="modalOverlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
        <div id="modalContent" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 24px; max-width: 600px; width: 90%; max-height: 80vh; overflow-y: auto;"></div>
    </div>

    <script src="/js/superadmin.js"></script>
</body>
</html>
