<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .dashboard-body {
            background: var(--bg-gradient-admin);
            min-height: 100vh;
        }
        .dashboard-header {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border-color);
            padding: 16px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            box-shadow: 0 4px 24px rgba(60, 130, 190, 0.05);
        }
        .dashboard-header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .dashboard-header-left .logo {
            font-size: 2rem;
            filter: drop-shadow(0 0 8px rgba(61, 155, 224, 0.3));
        }
        .dashboard-header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .plan-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .plan-free { background: rgba(107, 114, 128, 0.1); color: #718096; }
        .plan-pro { background: rgba(61, 155, 224, 0.15); color: #1b5e8c; }
        .plan-enterprise { background: rgba(27, 94, 140, 0.2); color: #1b5e8c; }
        
        .dashboard-main {
            padding: 32px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .welcome-section {
            margin-bottom: 32px;
        }
        .welcome-section h1 {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 8px;
        }
        .welcome-section p {
            color: var(--text-secondary);
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }
        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 24px;
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            box-shadow: 0 8px 32px rgba(60, 130, 190, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.6);
        }
        .stat-card .stat-icon {
            font-size: 2rem;
            margin-bottom: 12px;
        }
        .stat-card .stat-value {
            font-size: 2rem;
            font-weight: 800;
            color: var(--text-primary);
        }
        .stat-card .stat-label {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        
        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }
        .action-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 24px;
            text-decoration: none;
            color: var(--text-primary);
            transition: all 0.2s;
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            box-shadow: 0 8px 32px rgba(60, 130, 190, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.6);
        }
        .action-card:hover {
            border-color: var(--accent-primary);
            transform: translateY(-2px);
            box-shadow: 0 12px 40px rgba(60, 130, 190, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.6);
        }
        .action-card .action-icon {
            font-size: 2rem;
            margin-bottom: 12px;
        }
        .action-card h3 {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 4px;
        }
        .action-card p {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        
        .upgrade-banner {
            background: linear-gradient(135deg, #7cc4f2, #3d9be0);
            border-radius: var(--radius-lg);
            padding: 24px 32px;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
            box-shadow: 0 8px 32px rgba(61, 155, 224, 0.25);
        }
        .upgrade-banner h3 {
            font-size: 1.2rem;
            margin-bottom: 4px;
        }
        .upgrade-banner p {
            opacity: 0.9;
        }
        .upgrade-banner .btn {
            background: white;
            color: var(--accent-purple);
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 4px 12px rgba(27, 94, 140, 0.15);
        }
        
        .recent-orders {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 24px;
        }
        .recent-orders h3 {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 16px;
        }
        .order-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-color);
        }
        .order-row:last-child {
            border-bottom: none;
        }
        .order-row .order-num {
            font-weight: 600;
        }
        .order-row .order-status {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .status-pending { background: rgba(245, 158, 11, 0.2); color: #f59e0b; }
        .status-ready { background: rgba(34, 197, 94, 0.2); color: #22c55e; }
        .status-delivered { background: rgba(107, 114, 128, 0.2); color: #9ca3af; }
    </style>
</head>
<body class="dashboard-body">
    <header class="dashboard-header">
        <div class="dashboard-header-left">
            <img src="/images/logo.png" alt="UruBot" class="logo-img-sm">
            <div>
                <h2 style="margin: 0; font-size: 1.1rem;"><%= store ? store.name : 'Mi Negocio' %></h2>
                <span style="color: var(--text-secondary); font-size: 0.85rem;">Dashboard</span>
            </div>
        </div>
        <div class="dashboard-header-right">
            <span class="plan-badge plan-<%= user.plan %>"><%= user.plan === 'free' ? 'Gratis' : user.plan === 'pro' ? 'Pro' : 'Enterprise' %></span>
            <% if (user.role === 'superadmin') { %>
                <a href="/superadmin" class="btn-secondary" style="padding: 8px 16px; background: #312e81; color: white;">👑 Panel SaaS</a>
            <% } %>
            <a href="/admin" class="btn-secondary" style="padding: 8px 16px;">⚙️ Admin</a>
            <a href="/pedidos" class="btn-secondary" style="padding: 8px 16px;">🍳 Pedidos</a>
            <a href="/logout" style="color: var(--text-secondary); text-decoration: none;">Salir</a>
        </div>
    </header>

    <main class="dashboard-main">
        <div class="welcome-section">
            <h1>¡Hola, <%= user.name %>! 👋</h1>
            <p>Bienvenido a tu panel de <%= store ? store.business_type : 'negocio' %></p>
        </div>

        <% if (user.plan === 'free') { %>
        <div class="upgrade-banner">
            <div>
                <h3>¿Necesitás más? 🚀</h3>
                <p>Actualizá a Pro para pedidos ilimitados, 500 productos y reportes avanzados.</p>
            </div>
            <a href="/pricing" class="btn">Upgrade a Pro →</a>
        </div>
        <% } %>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">📦</div>
                <div class="stat-value"><%= pendingCount %></div>
                <div class="stat-label">Pedidos pendientes</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">💰</div>
                <div class="stat-value">$<%= recentOrders.reduce((sum, o) => sum + o.total, 0).toLocaleString() %></div>
                <div class="stat-label">Últimos pedidos</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">📋</div>
                <div class="stat-value"><%= recentOrders.length %></div>
                <div class="stat-label">Pedidos recientes</div>
            </div>
        </div>

        <div class="quick-actions">
            <a href="/admin" class="action-card">
                <div class="action-icon">📦</div>
                <h3>Gestionar Productos</h3>
                <p>Agregar, editar o pausar productos de tu catálogo</p>
            </a>
            <a href="/pedidos" class="action-card">
                <div class="action-icon">🍳</div>
                <h3>Dashboard Pedidos</h3>
                <p>Ver pedidos pendientes en tiempo real</p>
            </a>
            <a href="/simulator" class="action-card">
                <div class="action-icon">💬</div>
                <h3>Simulador Chat</h3>
                <p>Probar cómo responde tu asistente IA</p>
            </a>
            <a href="/admin#tab-whatsapp" class="action-card">
                <div class="action-icon">📱</div>
                <h3>Configurar WhatsApp</h3>
                <p>Conectar o desconectar tu número de WhatsApp</p>
            </a>
        </div>

        <% if (recentOrders.length > 0) { %>
        <div class="recent-orders">
            <h3>📜 Pedidos Recientes</h3>
            <% recentOrders.forEach(function(order) { %>
            <div class="order-row">
                <div>
                    <span class="order-num">#<%= order.order_number %></span>
                    <span style="color: var(--text-secondary); margin-left: 12px;"><%= order.customer_name || order.customer_phone %></span>
                </div>
                <div style="display: flex; align-items: center; gap: 16px;">
                    <span>$<%= order.total %></span>
                    <span class="order-status status-<%= order.status %>"><%= order.status %></span>
                </div>
            </div>
            <% }); %>
        </div>
        <% } %>
    </main>
</body>
</html>
