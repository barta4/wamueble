<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .simulator-body {
            background: var(--bg-gradient-admin);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .chat-phone {
            width: 100%;
            max-width: 400px;
            height: 90vh;
            background: rgba(255, 255, 255, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.55);
            border-radius: var(--radius-lg);
            display: flex;
            flex-direction: column;
            box-shadow: 0 8px 32px rgba(60, 130, 190, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            overflow: hidden;
            position: relative;
        }
        .chat-header {
            background: rgba(255, 255, 255, 0.55);
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.55);
            box-shadow: 0 2px 12px rgba(60, 130, 190, 0.05);
        }
        .avatar {
            width: 40px;
            height: 40px;
            background: var(--accent-orange);
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            box-shadow: 0 2px 8px rgba(60, 130, 190, 0.1);
        }
        .chat-info h2 {
            font-size: 1.1rem;
            color: var(--text-primary);
            margin-bottom: 2px;
        }
        .chat-info p {
            font-size: 0.8rem;
            color: var(--accent-primary);
        }
        .chat-messages {
            flex: 1;
            padding: 16px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
            background: rgba(61, 155, 224, 0.05);
        }
        .msg {
            max-width: 80%;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 0.95rem;
            line-height: 1.4;
            word-wrap: break-word;
            box-shadow: 0 2px 8px rgba(60, 130, 190, 0.04);
        }
        .msg-bot {
            background: rgba(255, 255, 255, 0.65);
            color: var(--text-primary);
            align-self: flex-start;
            border-bottom-left-radius: 4px;
        }
        .msg-user {
            background: rgba(124, 196, 242, 0.3);
            color: var(--text-primary);
            align-self: flex-end;
            border-bottom-right-radius: 4px;
        }
        .chat-input {
            padding: 16px;
            background: rgba(255, 255, 255, 0.55);
            border-top: 1px solid rgba(255, 255, 255, 0.55);
            display: flex;
            gap: 8px;
        }
        .chat-input input {
            flex: 1;
            padding: 12px 16px;
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.55);
            background: rgba(255, 255, 255, 0.6);
            color: var(--text-primary);
            font-family: var(--font-ui);
        }
        .chat-input input:focus {
            outline: none;
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 2px var(--accent-primary-glow);
        }
        .chat-input button {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg, #7cc4f2, #3d9be0);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.2s;
            box-shadow: 0 4px 12px rgba(61, 155, 224, 0.25);
        }
        .chat-input button:hover {
            transform: scale(1.05);
        }
        .typing {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 4px;
            display: none;
        }
    </style>
</head>
<body class="simulator-body">

    <div class="chat-phone">
        <div class="chat-header">
            <div class="avatar">🤖</div>
            <div class="chat-info">
                <h2>WaBot SaaS</h2>
                <p>En línea</p>
            </div>
        </div>
        
        <div class="chat-messages" id="messages">
            <div class="msg msg-bot">
                ¡Hola! Soy el asistente virtual de WaBot SaaS. ¿En qué te puedo ayudar hoy?
            </div>
        </div>
        
        <div class="chat-input">
            <button id="micBtn" onclick="toggleRecording()" style="background: var(--bg-surface); color: var(--text-primary); margin-right: 8px;">🎤</button>
            <input type="text" id="msgInput" placeholder="Escribe un mensaje..." onkeypress="handleEnter(event)">
            <button onclick="sendMessage()">➤</button>
        </div>
    </div>

    <script>
        const phone = "+59899000" + Math.floor(Math.random() * 999); // Teléfono random para la sesión
        
        let mediaRecorder;
        let audioChunks = [];
        let isRecording = false;

        async function toggleRecording() {
            const micBtn = document.getElementById('micBtn');
            if (isRecording) {
                mediaRecorder.stop();
                isRecording = false;
                micBtn.style.color = 'var(--text-primary)';
                micBtn.style.transform = 'scale(1)';
            } else {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);
                    audioChunks = [];

                    mediaRecorder.ondataavailable = e => {
                        if (e.data.size > 0) audioChunks.push(e.data);
                    };

                    mediaRecorder.onstop = async () => {
                        const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                        sendAudio(audioBlob);
                        stream.getTracks().forEach(track => track.stop());
                    };

                    mediaRecorder.start();
                    isRecording = true;
                    micBtn.style.color = 'red';
                    micBtn.style.transform = 'scale(1.1)';
                } catch (err) {
                    alert('No se pudo acceder al micrófono: ' + err.message);
                }
            }
        }

        async function sendAudio(blob) {
            appendMessage('🎤 [Mensaje de voz]', 'user');

            const typingDiv = document.createElement('div');
            typingDiv.className = 'msg msg-bot typing-indicator';
            typingDiv.textContent = 'Escribiendo...';
            document.getElementById('messages').appendChild(typingDiv);
            document.getElementById('messages').scrollTop = document.getElementById('messages').scrollHeight;

            const reader = new FileReader();
            reader.readAsDataURL(blob);
            reader.onloadend = async () => {
                const base64String = reader.result.split(',')[1];
                try {
                    const res = await fetch('/api/simulate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ phone: phone, audioBase64: base64String })
                    });
                    
                    const data = await res.json();
                    typingDiv.remove();
                    
                    if (data.reply) {
                        appendMessage(data.reply, 'bot');
                    } else if (data.error) {
                        appendMessage(`⚠️ Error: ${data.error}`, 'bot');
                    }
                } catch (err) {
                    typingDiv.remove();
                    appendMessage('⚠️ Error de conexión con el simulador.', 'bot');
                }
            };
        }
        
        function appendMessage(text, sender) {
            const container = document.getElementById('messages');
            const div = document.createElement('div');
            div.className = `msg msg-${sender}`;
            div.innerHTML = text.replace(/\n/g, '<br>').replace(/\*(.*?)\*/g, '<b>$1</b>');
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }
        
        async function sendMessage() {
            const input = document.getElementById('msgInput');
            const text = input.value.trim();
            if (!text) return;
            
            appendMessage(text, 'user');
            input.value = '';
            
            // Simular "Escribiendo..."
            const typingDiv = document.createElement('div');
            typingDiv.className = 'msg msg-bot typing-indicator';
            typingDiv.textContent = 'Escribiendo...';
            document.getElementById('messages').appendChild(typingDiv);
            document.getElementById('messages').scrollTop = document.getElementById('messages').scrollHeight;
            
            try {
                const res = await fetch('/api/simulate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ messageText: text, phone: phone })
                });
                
                const data = await res.json();
                typingDiv.remove();
                
                if (data.reply) {
                    appendMessage(data.reply, 'bot');
                } else if (data.error) {
                    appendMessage(`⚠️ Error: ${data.error}`, 'bot');
                }
            } catch (err) {
                typingDiv.remove();
                appendMessage('⚠️ Error de conexión con el simulador.', 'bot');
            }
        }
        
        function handleEnter(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        }
    </script>
</body>
</html>
