<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=6">
    <script src="/js/theme-toggle.js"></script>
    <style>
        .register-body {
            background: var(--bg-gradient-admin);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 20px;
            position: relative;
        }
        .register-theme-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-pill);
            padding: 8px 14px;
            cursor: pointer;
            font-size: 1.1rem;
            color: var(--text-primary);
            backdrop-filter: blur(16px);
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }
        .register-theme-btn:hover {
            transform: scale(1.05);
            background: var(--bg-card-hover);
        }
        .register-container {
            width: 100%;
            max-width: 580px;
        }
        .register-card {
            background: var(--bg-card);
            backdrop-filter: blur(24px) saturate(180%);
            -webkit-backdrop-filter: blur(24px) saturate(180%);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-xl);
            padding: 40px;
            box-shadow: var(--shadow-lg);
            position: relative;
            overflow: hidden;
            animation: saasModalScaleUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .register-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #128c7e, #00a884, #06b6d4);
        }
        .register-logo {
            text-align: center;
            margin-bottom: 20px;
        }
        .logo-img-lg {
            width: 72px;
            height: auto;
            border-radius: var(--radius-md);
            filter: drop-shadow(0 4px 12px rgba(0, 168, 132, 0.3));
        }
        .register-title {
            text-align: center;
            font-size: 1.85rem;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 6px;
            letter-spacing: -0.02em;
        }
        .register-subtitle {
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.92rem;
            margin-bottom: 28px;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        .form-group {
            margin-bottom: 18px;
        }
        .form-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-secondary);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .form-group input,
        .form-group select {
            width: 100%;
            padding: 11px 14px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
            background: var(--bg-input);
            color: var(--text-primary);
            font-family: var(--font-ui);
            font-size: 0.92rem;
            transition: var(--transition);
            box-sizing: border-box;
        }
        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: var(--accent-primary);
            background: var(--bg-secondary);
            box-shadow: 0 0 0 3px var(--accent-primary-glow);
        }
        .form-group select option {
            background: var(--bg-secondary);
            color: var(--text-primary);
        }
        .btn-submit {
            width: 100%;
            padding: 14px;
            font-size: 1rem;
            font-weight: 700;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, #128c7e, #00a884);
            color: #ffffff;
            border: none;
            cursor: pointer;
            box-shadow: 0 4px 16px rgba(0, 168, 132, 0.35);
            transition: var(--transition);
            font-family: var(--font-ui);
            margin-top: 10px;
        }
        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 168, 132, 0.45);
        }
        .login-link {
            text-align: center;
            margin-top: 24px;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        .login-link a {
            color: var(--accent-primary);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }
        .login-link a:hover {
            text-decoration: underline;
        }
        .mode-selector-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 12px;
            margin-bottom: 20px;
        }
        .mode-card {
            position: relative;
            cursor: pointer;
        }
        .mode-card input[type="radio"] {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
        }
        .mode-card-inner {
            background: var(--bg-input);
            border: 2px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 12px 10px;
            text-align: center;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }
        .mode-card input[type="radio"]:checked + .mode-card-inner {
            border-color: var(--accent-primary);
            background: var(--accent-primary-glow);
            box-shadow: 0 4px 14px rgba(0, 168, 132, 0.25);
            transform: translateY(-2px);
        }
        .mode-icon {
            font-size: 1.5rem;
            line-height: 1;
        }
        .mode-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-primary);
        }
        .mode-desc {
            font-size: 0.72rem;
            color: var(--text-secondary);
            line-height: 1.2;
        }
        .error-msg {
            background: rgba(244, 63, 94, 0.1);
            border: 1px solid rgba(244, 63, 94, 0.25);
            color: var(--accent-red);
            padding: 12px 16px;
            border-radius: var(--radius-md);
            margin-bottom: 20px;
            text-align: center;
            font-size: 0.88rem;
            font-weight: 500;
        }

        @media (max-width: 600px) {
            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
            .register-card {
                padding: 28px 20px;
            }
            .register-title {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body class="register-body">
    <button id="themeToggleBtn" class="register-theme-btn" title="Cambiar Tema">🌙</button>

    <div class="register-container">
        <div class="register-card">
            <div class="register-logo">
                <img src="/images/logo.png" alt="WaBot" class="logo-img-lg" onerror="this.style.display='none'">
            </div>
            <h1 class="register-title">Crear Cuenta</h1>
            <p class="register-subtitle">Registrate gratis y gestioná tu negocio con IA por WhatsApp</p>

            <% if (error) { %>
                <div class="error-msg"><%= error %></div>
            <% } %>

            <form action="/register" method="POST">
                <div class="form-group">
                    <label>Modo de Operación del Negocio</label>
                    <div class="mode-selector-grid">
                        <label class="mode-card">
                            <input type="radio" name="operatingMode" value="store" checked>
                            <div class="mode-card-inner">
                                <span class="mode-icon">🛍️</span>
                                <span class="mode-title">Tienda / Pedidos</span>
                                <span class="mode-desc">Catálogo y Carrito</span>
                            </div>
                        </label>
                        <label class="mode-card">
                            <input type="radio" name="operatingMode" value="clinic">
                            <div class="mode-card-inner">
                                <span class="mode-icon">🏥</span>
                                <span class="mode-title">Clínica / Turnos</span>
                                <span class="mode-desc">Agendamiento de Citas</span>
                            </div>
                        </label>
                        <label class="mode-card">
                            <input type="radio" name="operatingMode" value="hostel">
                            <div class="mode-card-inner">
                                <span class="mode-icon">🏨</span>
                                <span class="mode-title">Hostel / Reserva</span>
                                <span class="mode-desc">Alojamiento y Camas</span>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label for="name">Tu nombre</label>
                    <input type="text" id="name" name="name" placeholder="Ej. Juan Pérez" required>
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="juan@negocio.com" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <input type="password" id="password" name="password" placeholder="Mínimo 6 caracteres" minlength="6" required>
                    </div>
                    <div class="form-group">
                        <label for="confirmPassword">Confirmar</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repetí la contraseña" required>
                    </div>
                </div>

                <div class="form-group">
                    <label for="businessType">Rubro / Plantilla</label>
                    <select id="businessType" name="businessType" required>
                        <option value="">Seleccioná tu rubro</option>
                        <% var keys = Object.keys(templates); for (var i = 0; i < keys.length; i++) { var key = keys[i]; var template = templates[key]; %>
                            <option value="<%= key %>"><%= template.emoji %> <%= template.name %></option>
                        <% } %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="storeName">Nombre del local</label>
                    <input type="text" id="storeName" name="storeName" placeholder="Ej. Mi Pizzería / Clínica Central" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="phone">WhatsApp (opcional)</label>
                        <input type="text" id="phone" name="phone" placeholder="+59899111111">
                    </div>
                    <div class="form-group">
                        <label for="address">Dirección (opcional)</label>
                        <input type="text" id="address" name="address" placeholder="Av. 18 de Julio 1234">
                    </div>
                </div>

                <button type="submit" class="btn-submit">Crear Mi Cuenta Gratis</button>
            </form>

            <div class="login-link">
                ¿Ya tenés cuenta? <a href="/login">Iniciar Sesión</a>
            </div>
        </div>
    </div>
</body>
</html>
