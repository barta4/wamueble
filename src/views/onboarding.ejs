<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
    <style>
        .onboarding-body {
            background: var(--bg-gradient-admin);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .onboarding-container {
            width: 100%;
            max-width: 600px;
        }
        .onboarding-card {
            background: rgba(255, 255, 255, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.55);
            border-radius: var(--radius-lg);
            padding: 40px;
            box-shadow: 0 8px 32px rgba(60, 130, 190, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
        }
        .onboarding-logo {
            text-align: center;
            font-size: 3rem;
            margin-bottom: 8px;
        }
        .onboarding-title {
            text-align: center;
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 8px;
        }
        .onboarding-subtitle {
            text-align: center;
            color: var(--text-secondary);
            margin-bottom: 32px;
        }
        .step-indicator {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 32px;
        }
        .step-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: rgba(28, 58, 82, 0.1);
        }
        .step-dot.active {
            background: var(--accent-primary);
            box-shadow: 0 0 8px var(--accent-primary-glow);
        }
        .step-dot.completed {
            background: var(--accent-primary);
        }
        .step-section {
            display: none;
        }
        .step-section.active {
            display: block;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 6px;
        }
        .form-group input,
        .form-group select {
            width: 100%;
            padding: 12px 16px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: var(--bg-input);
            color: var(--text-primary);
            font-family: var(--font-ui);
            font-size: 1rem;
        }
        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 3px var(--accent-primary-glow);
        }
        .btn-row {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }
        .btn-primary {
            flex: 1;
        }
        .btn-secondary {
            flex: 1;
        }
        .success-icon {
            text-align: center;
            font-size: 5rem;
            margin-bottom: 16px;
        }
        .success-text {
            text-align: center;
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 8px;
        }
        .success-subtext {
            text-align: center;
            color: var(--text-secondary);
            margin-bottom: 24px;
        }
    </style>
</head>
<body class="onboarding-body">
    <div class="onboarding-container">
        <div class="onboarding-card">
            <div class="onboarding-logo"><img src="/images/logo.png" alt="UruBot" class="logo-img-lg"></div>
            <h1 class="onboarding-title">Configuración Inicial</h1>
            <p class="onboarding-subtitle">Configurá tu Asistente de IA en 2 pasos simples</p>

            <div class="step-indicator">
                <div class="step-dot active" id="dot-1"></div>
                <div class="step-dot" id="dot-2"></div>
            </div>

            <!-- Paso 1: Configuración Exprés del Negocio -->
            <div class="step-section active" id="step-1">
                <h3 style="margin-bottom: 12px; font-size: 1.1rem; color: var(--text-primary);">1. Seleccioná tu rubro o tipo de negocio</h3>
                
                <!-- Grid Visual de Rubros -->
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 20px;">
                    <% Object.entries(templates).forEach(([key, template]) => { %>
                        <div class="template-card" onclick="selectTemplateCard('<%= key %>')" id="card-<%= key %>" style="border: 2px solid var(--border-color); border-radius: 12px; padding: 12px 8px; text-align: center; cursor: pointer; background: var(--bg-surface); transition: all 0.2s;">
                            <div style="font-size: 1.8rem;"><%= template.emoji %></div>
                            <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin-top: 4px;"><%= template.name %></div>
                        </div>
                    <% }); %>
                </div>
                <input type="hidden" id="businessType" value="<%= store && store.business_type ? store.business_type : 'pizzeria' %>">

                <div class="form-group">
                    <label>Nombre de tu local *</label>
                    <input type="text" id="storeName" value="<%= store ? store.name : '' %>" placeholder="Ej: Pizzería Don Pepe" required>
                </div>

                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                        <label style="margin: 0;">Descripción / Instrucciones para la IA *</label>
                        <button type="button" onclick="generateOnboardingPrompt()" id="btnGenOnboardingPrompt" style="font-size: 0.8rem; padding: 4px 10px; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; border: none; border-radius: 6px; cursor: pointer;">✨ Autocompletar con IA</button>
                    </div>
                    <textarea id="storeDescription" rows="3" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-input); color: var(--text-primary); font-family: inherit; font-size: 0.9rem; resize: vertical;" placeholder="Ej: Pizzería artesanal. Ofrecemos pizzas a la piedra, empanadas y postres. Delivery propio."><%= store ? (store.ai_prompt || store.description || '') : '' %></textarea>
                </div>

                <!-- Checkbox Mágico de Catálogo de Muestra -->
                <div style="background: rgba(99, 102, 241, 0.08); border: 1px dashed #6366f1; padding: 12px; border-radius: 10px; margin-bottom: 20px;">
                    <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; margin: 0; font-weight: 600; font-size: 0.9rem; color: var(--text-primary);">
                        <input type="checkbox" id="seedCatalogCheckbox" checked style="width: 18px; height: 18px; accent-color: #6366f1;">
                        🌱 Cargar catálogo de muestra para probar mi bot de inmediato
                    </label>
                    <span style="font-size: 0.78rem; color: var(--text-secondary); display: block; margin-top: 4px; margin-left: 28px;">Creará automáticamente 3 o 4 productos iniciales (precios y nombres de muestra) que podrás modificar después.</span>
                </div>

                <div class="btn-row">
                    <a href="/dashboard" class="btn-secondary" style="text-align: center; text-decoration: none;">Omitir e ir al Dashboard</a>
                    <button class="btn-primary" onclick="saveAndNext()" style="font-weight: 700;">Continuar al Paso 2 →</button>
                </div>
            </div>

            <!-- Paso 2: Conexión o Prueba Instantánea -->
            <div class="step-section" id="step-2">
                <div style="text-align: center; margin-bottom: 16px;">
                    <div style="width: 48px; height: 48px; background: rgba(37, 211, 102, 0.15); color: #25D366; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 6px;">
                        💬
                    </div>
                    <h2 style="font-size: 1.3rem; font-weight: 800; color: var(--text-primary); margin-bottom: 2px;">¡Tu Bot de IA está listo!</h2>
                    <p style="color: var(--text-secondary); font-size: 0.85rem;">
                        Vincularlo a tu WhatsApp o probá cómo responde ahora mismo en el simulador.
                    </p>
                </div>

                <!-- Botón destacado de Prueba Instantánea -->
                <div style="margin-bottom: 18px; text-align: center;">
                    <a href="/simulator" class="btn-primary" style="display: block; width: 100%; text-align: center; text-decoration: none; padding: 12px; background: linear-gradient(135deg, #6366f1, #8b5cf6); border: none; font-weight: 700; border-radius: 10px; font-size: 0.95rem;">
                        💬 Probar mi Asistente en el Simulador Web →
                    </a>
                </div>

                <div style="text-align: center; margin: 12px 0; color: var(--text-muted); font-weight: 700; font-size: 0.8rem;">O VINCULÁ TU WHATSAPP REAL</div>

                <!-- Panel QR Baileys Directo -->
                <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 14px; padding: 16px; text-align: center; margin-bottom: 16px;">
                    <div class="form-group" style="text-align: left; margin-bottom: 10px;">
                        <label style="font-weight: 600; font-size: 0.82rem;">Tu número de WhatsApp (con código de país):</label>
                        <input type="text" id="onboardingWaPhone" placeholder="Ej: +59899111111" value="<%= store ? store.phone : '' %>" style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-input); color: var(--text-primary); font-size: 0.9rem;">
                    </div>
                    
                    <button type="button" onclick="initBaileysQr()" class="btn-primary" style="width: 100%; padding: 10px; font-weight: 700; background: linear-gradient(135deg, #075E54, #25D366); border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem;">
                        ⚡ Generar Código QR de WhatsApp
                    </button>

                    <!-- Área del Código QR -->
                    <div id="onboardingQrContainer" style="display: none; background: white; padding: 12px; border-radius: 12px; border: 1px solid var(--border-color); max-width: 200px; margin: 12px auto 0;">
                        <canvas id="onboardingQrCanvas" style="margin: 0 auto; display: block;"></canvas>
                        <p style="color: #4a5d6e; font-size: 0.75rem; margin-top: 6px; margin-bottom: 0;">Escaneá con tu celular</p>
                    </div>

                    <!-- Estado de la Conexión -->
                    <div id="onboardingWaStatus" style="margin-top: 8px; font-weight: 700; font-size: 0.85rem; color: var(--text-secondary);"></div>
                </div>

                <!-- Enlace Avanzado Meta Cloud API -->
                <div style="text-align: center; margin-bottom: 14px;">
                    <a href="javascript:void(0)" onclick="toggleMetaPanel()" style="font-size: 0.8rem; color: var(--text-secondary); text-decoration: underline;">
                        ⚙️ Configuración Avanzada (Meta Cloud API)
                    </a>
                </div>

                <div id="panelWaMeta" style="display: none; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 14px; margin-bottom: 16px;">
                    <div class="form-group" style="margin-bottom: 8px;">
                        <input type="text" id="metaPhone" placeholder="Teléfono" value="<%= store ? store.phone : '' %>" style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-input); font-size: 0.85rem;">
                    </div>
                    <div class="form-group" style="margin-bottom: 8px;">
                        <input type="password" id="metaAccessToken" placeholder="Meta Access Token" style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-input); font-size: 0.85rem;">
                    </div>
                    <div class="form-group" style="margin-bottom: 8px;">
                        <input type="text" id="metaPhoneId" placeholder="Phone Number ID" style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-input); font-size: 0.85rem;">
                    </div>
                    <button type="button" onclick="saveMetaConfig()" class="btn-primary" style="width: 100%; padding: 8px; font-weight: 700; background: #00a884; border: none; border-radius: 6px; cursor: pointer; font-size: 0.85rem;">
                        Guardar Meta API
                    </button>
                </div>

                <!-- Enlace final al Dashboard -->
                <div style="display: flex; gap: 10px;">
                    <button class="btn-secondary" onclick="nextStep(1)" style="flex: 1;">← Volver al Paso 1</button>
                    <a href="/dashboard" class="btn-secondary" style="flex: 1; text-align: center; text-decoration: none; padding: 10px;">Ir al Dashboard →</a>
                </div>
            </div>

            <!-- Paso 4: Completado -->
            <div class="step-section" id="step-4">
                <div class="success-icon">🎉</div>
                <div class="success-text">¡Todo listo!</div>
                <div class="success-subtext">Tu asistente IA está configurado y listo para recibir clientes.</div>
                <div style="text-align: center;">
                    <a href="/dashboard" class="btn-primary" style="display: inline-block; width: auto; padding: 14px 32px;">Ir al Dashboard →</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentStep = 1;
        let currentConnectionId = null;
        let socket = null;

        function nextStep(step) {
            document.querySelectorAll('.step-section').forEach(s => s.classList.remove('active'));
            const targetSection = document.getElementById('step-' + step);
            if (targetSection) targetSection.classList.add('active');
            
            for (let i = 1; i <= 2; i++) {
                const dot = document.getElementById('dot-' + i);
                if (dot) {
                    dot.classList.remove('active', 'completed');
                    if (i < step) dot.classList.add('completed');
                    if (i === step) dot.classList.add('active');
                }
            }
            
            currentStep = step;
        }

        function selectTemplateCard(key) {
            document.querySelectorAll('.template-card').forEach(card => {
                card.style.borderColor = 'var(--border-color)';
                card.style.background = 'var(--bg-surface)';
            });

            const selectedCard = document.getElementById('card-' + key);
            if (selectedCard) {
                selectedCard.style.borderColor = '#6366f1';
                selectedCard.style.background = 'rgba(99, 102, 241, 0.08)';
            }

            document.getElementById('businessType').value = key;

            // Autocompletar descripción si está vacía
            const templates = JSON.parse('<%- JSON.stringify(templates || {}).replace(/\\'/g, "\\\'") %>');
            const descEl = document.getElementById('storeDescription');
            if (descEl && templates[key] && !descEl.value.trim()) {
                descEl.value = templates[key].aiPrompt || '';
            }
        }

        // Seleccionar por defecto la primera plantilla al cargar
        document.addEventListener('DOMContentLoaded', () => {
            const currentBType = document.getElementById('businessType').value || 'pizzeria';
            selectTemplateCard(currentBType);
        });

        function toggleMetaPanel() {
            const p = document.getElementById('panelWaMeta');
            if (p) p.style.display = p.style.display === 'none' ? 'block' : 'none';
        }

        async function saveAndNext() {
            const name = document.getElementById('storeName').value;
            const description = document.getElementById('storeDescription').value;
            const businessType = document.getElementById('businessType').value;
            const seedCatalog = document.getElementById('seedCatalogCheckbox') ? document.getElementById('seedCatalogCheckbox').checked : true;

            if (!name || !name.trim()) {
                alert('Por favor ingresá el nombre de tu local.');
                return;
            }

            const data = {
                name: name.trim(),
                description: description ? description.trim() : '',
                aiPrompt: description ? description.trim() : '',
                businessType,
                seedCatalog
            };

            try {
                const response = await fetch('/api/store', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                if (response.ok) {
                    nextStep(2);
                } else {
                    alert('Error al guardar la configuración. Intentá de nuevo.');
                }
            } catch (e) {
                alert('Error de conexión.');
            }
        }

        async function initBaileysQr() {
            const phone = document.getElementById('onboardingWaPhone').value.trim();
            if (!phone) {
                alert('Ingresá el número de teléfono con código de país (ej: +59899111111)');
                return;
            }

            const statusEl = document.getElementById('onboardingWaStatus');
            statusEl.textContent = '🔄 Iniciando sesión de WhatsApp...';
            statusEl.style.color = 'var(--accent-orange)';

            try {
                const resConn = await fetch('/api/whatsapp/connections');
                const dataConn = await resConn.json();
                
                let conn = dataConn.connections && dataConn.connections.length > 0 ? dataConn.connections[0] : null;

                if (!conn) {
                    const createRes = await fetch('/api/whatsapp/connections', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ mode: 'baileys', phone })
                    });
                    const createData = await createRes.json();
                    if (!createRes.ok) throw new Error(createData.error || 'Error al crear conexión');
                    conn = createData.connection;
                }

                currentConnectionId = conn.id;

                if (!socket) {
                    socket = io();
                    socket.emit('join-admin');
                    socket.on('whatsapp-qr', (data) => {
                        if (data && Number(data.connectionId) === Number(currentConnectionId)) {
                            const container = document.getElementById('onboardingQrContainer');
                            const canvas = document.getElementById('onboardingQrCanvas');
                            if (container && canvas && window.QRCode) {
                                container.style.display = 'block';
                                QRCode.toCanvas(canvas, data.qr, function (err) {
                                    if (err) console.error(err);
                                });
                                statusEl.textContent = '📲 Escaneá el código QR desde tu celular';
                                statusEl.style.color = 'var(--accent-primary)';
                            }
                        }
                    });

                    socket.on('whatsapp-status', (data) => {
                        if (data && Number(data.connectionId) === Number(currentConnectionId)) {
                            if (data.status === 'connected') {
                                document.getElementById('onboardingQrContainer').style.display = 'none';
                                statusEl.textContent = '✅ ¡WhatsApp Conectado exitosamente!';
                                statusEl.style.color = 'var(--wa-green)';
                            }
                        }
                    });
                }

                await fetch(`/api/whatsapp/connections/${currentConnectionId}/switch-baileys`, { method: 'POST' });

            } catch (e) {
                statusEl.textContent = '❌ Error: ' + e.message;
                statusEl.style.color = 'var(--accent-red)';
            }
        }

        async function saveMetaConfig() {
            const phone = document.getElementById('metaPhone').value.trim();
            const accessToken = document.getElementById('metaAccessToken').value.trim();
            const phoneId = document.getElementById('metaPhoneId').value.trim();
            const verifyToken = document.getElementById('metaVerifyToken').value.trim();

            if (!accessToken || !phoneId) {
                alert('Ingresá el Meta Access Token y el Phone Number ID.');
                return;
            }

            try {
                const resConn = await fetch('/api/whatsapp/connections');
                const dataConn = await resConn.json();
                let conn = dataConn.connections && dataConn.connections.length > 0 ? dataConn.connections[0] : null;

                if (!conn) {
                    const createRes = await fetch('/api/whatsapp/connections', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ mode: 'meta', phone, meta_access_token: accessToken, meta_phone_id: phoneId, meta_verify_token: verifyToken })
                    });
                    const createData = await createRes.json();
                    if (!createRes.ok) throw new Error(createData.error || 'Error al crear conexión');
                    conn = createData.connection;
                }

                const saveRes = await fetch(`/api/whatsapp/connections/${conn.id}/save-meta`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ accessToken, phoneId, verifyToken, phone })
                });
                
                if (saveRes.ok) {
                    alert('✅ Configuración Meta Cloud API guardada correctamente.');
                    window.location.href = '/dashboard';
                } else {
                    const err = await saveRes.json();
                    alert('Error: ' + (err.error || 'No se pudo guardar la configuración'));
                }
            } catch (e) {
                alert('Error de conexión: ' + e.message);
            }
        }

        function finishOnboarding() {
            window.location.href = '/dashboard';
        }

        async function generateOnboardingPrompt() {
            const descInput = document.getElementById('storeDescription');
            const description = descInput ? descInput.value.trim() : '';
            const storeName = document.getElementById('storeName') ? document.getElementById('storeName').value.trim() : '';

            if (!description) {
                alert('⚠️ Por favor escribe primero una breve descripción de tu negocio.');
                return;
            }

            const btn = document.getElementById('btnGenOnboardingPrompt');
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = '⏳ Mejorando...';

            try {
                const res = await fetch('/api/ai/generate-prompt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        description: `${storeName ? `Negocio: ${storeName}. ` : ''}${description}`, 
                        tone: 'Amigable y atento',
                        rules: '',
                        businessType: 'general'
                    })
                });

                const data = await res.json();
                if (res.ok && data.success && data.generatedPrompt) {
                    descInput.value = data.generatedPrompt;
                    alert('✨ ¡Prompt mejorado exitosamente con Inteligencia Artificial!');
                } else {
                    alert('Error: ' + (data.error || 'No se pudo generar el prompt'));
                }
            } catch (err) {
                alert('Error de conexión: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.textContent = originalText;
            }
        }
    </script>
</body>
</html>
