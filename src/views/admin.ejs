<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=6">
    <link rel="stylesheet" href="/css/chat-pro.css?v=6">
    <script src="/js/theme-toggle.js"></script>
</head>
<body class="admin-body">
    <!-- Header Admin Pro -->
    <header class="admin-header">
        <div class="header-left">
            <!-- Botón Hamburguesa Móvil -->
            <button type="button" class="mobile-drawer-toggle" id="drawerOpenBtn" onclick="openAdminDrawer()" aria-label="Abrir Menú de Navegación">
                <span class="burger-bar"></span>
                <span class="burger-bar"></span>
                <span class="burger-bar"></span>
            </button>
            
            <div class="store-brand-badge">
                <div class="store-avatar">
                    <img src="/images/logo.png" alt="Logo" class="logo-img-sm" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <span class="avatar-fallback" style="display: none;"><%= (store && store.name ? store.name.charAt(0) : 'W').toUpperCase() %></span>
                </div>
                <div class="store-meta">
                    <div class="store-title-row">
                        <h1 class="store-name"><%= store ? store.name : 'WaBot' %></h1>
                        <span class="status-live-dot" title="Sistema en Línea"></span>
                    </div>
                    <div class="store-pills">
                        <span class="badge-role">Admin</span>
                        <% if (store && store.clinic_mode === 1) { %>
                            <span class="badge-mode clinic">🏥 Clínica</span>
                        <% } else if (store && store.hostel_mode === 1) { %>
                            <span class="badge-mode hostel">🏨 Hostel</span>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="header-right">
            <% if (user && user.role === 'superadmin') { %>
                <a href="/superadmin" class="nav-link saas-badge-link" title="Panel SaaS Global">
                    <span class="nav-icon">👑</span>
                    <span class="nav-text">SaaS</span>
                </a>
            <% } %>
            <a href="/pedidos" class="nav-link kitchen-link" title="Monitor de Pedidos">
                <span class="nav-icon">📺</span>
                <span class="nav-text">Pedidos</span>
            </a>
            <button type="button" id="themeToggleBtn" class="nav-btn-icon" title="Cambiar Tema (Claro / Oscuro)">🌙</button>
            <a href="/logout" class="nav-link logout-btn" title="Cerrar Sesión">
                <span class="nav-icon">🚪</span>
                <span class="nav-text">Salir</span>
            </a>
        </div>
    </header>

    <main class="admin-main">
        <!-- Barra de Navegación Moderna de Fila Única con Dropdowns Desplegables -->
        <nav class="admin-modern-navbar" id="adminModernNav" aria-label="Navegación Principal">
            <!-- 1. Catálogo (Dropdown si tiene servicios/hostel, o directo si es solo productos) -->
            <% if ((store && store.clinic_mode === 1) || (store && store.hostel_mode === 1)) { %>
                <div class="nav-dropdown" id="dropdownCatalog">
                    <button type="button" class="modern-nav-btn dropdown-trigger active" id="triggerCatalog" onclick="toggleNavDropdown('dropdownCatalog', event)">
                        <span class="btn-icon">📦</span>
                        <span class="btn-text">Catálogo</span>
                        <span class="dropdown-arrow">▾</span>
                    </button>
                    <div class="dropdown-panel">
                        <button type="button" class="dropdown-item active" data-tab="products" onclick="selectDropdownOption('products', 'dropdownCatalog')">
                            <span class="dropdown-item-icon">📦</span>
                            <div class="dropdown-item-content">
                                <span class="dropdown-item-name">Productos</span>
                                <span class="dropdown-item-sub">Inventario, precios y stock</span>
                            </div>
                        </button>
                        <button type="button" class="dropdown-item" data-tab="services" onclick="selectDropdownOption('services', 'dropdownCatalog')" id="tab-services-btn" style="<%= (store && store.clinic_mode === 1) ? '' : 'display: none;' %>">
                            <span class="dropdown-item-icon">⚕️</span>
                            <div class="dropdown-item-content">
                                <span class="dropdown-item-name">Servicios</span>
                                <span class="dropdown-item-sub">Tratamientos y duración</span>
                            </div>
                        </button>
                        <button type="button" class="dropdown-item" data-tab="rooms" onclick="selectDropdownOption('rooms', 'dropdownCatalog')" id="tab-rooms-btn" style="<%= (store && store.hostel_mode === 1) ? '' : 'display: none;' %>">
                            <span class="dropdown-item-icon">🛏️</span>
                            <div class="dropdown-item-content">
                                <span class="dropdown-item-name">Habitaciones</span>
                                <span class="dropdown-item-sub">Tipos de habitación y camas</span>
                            </div>
                        </button>
                        <button type="button" class="dropdown-item" data-tab="bookings" onclick="selectDropdownOption('bookings', 'dropdownCatalog')" id="tab-bookings-btn" style="<%= (store && store.hostel_mode === 1) ? '' : 'display: none;' %>">
                            <span class="dropdown-item-icon">🏨</span>
                            <div class="dropdown-item-content">
                                <span class="dropdown-item-name">Reservas</span>
                                <span class="dropdown-item-sub">Huéspedes y ocupación</span>
                            </div>
                        </button>
                    </div>
                </div>
            <% } else { %>
                <button type="button" class="modern-nav-btn active" data-tab="products" onclick="switchTab('products')">
                    <span class="btn-icon">📦</span>
                    <span class="btn-text">Catálogo</span>
                </button>
            <% } %>

            <!-- 2. Citas (Dropdown para modo clínica) -->
            <div class="nav-dropdown" id="dropdownAppointments" style="<%= (store && store.clinic_mode === 1) ? '' : 'display: none;' %>">
                <button type="button" class="modern-nav-btn dropdown-trigger" id="triggerAppointments" onclick="toggleNavDropdown('dropdownAppointments', event)">
                    <span class="btn-icon">📅</span>
                    <span class="btn-text">Citas</span>
                    <span class="dropdown-arrow">▾</span>
                </button>
                <div class="dropdown-panel">
                    <button type="button" class="dropdown-item" data-tab="appointments" onclick="selectDropdownOption('appointments', 'dropdownAppointments')" id="tab-appointments-btn">
                        <span class="dropdown-item-icon">📅</span>
                        <div class="dropdown-item-content">
                            <span class="dropdown-item-name">Calendario de Citas</span>
                            <span class="dropdown-item-sub">Agenda, turnos y horarios</span>
                        </div>
                    </button>
                    <button type="button" class="dropdown-item" data-tab="doctors" onclick="selectDropdownOption('doctors', 'dropdownAppointments')" id="tab-doctors-btn">
                        <span class="dropdown-item-icon">👨‍⚕️</span>
                        <div class="dropdown-item-content">
                            <span class="dropdown-item-name">Doctores & Especialistas</span>
                            <span class="dropdown-item-sub">Médicos y profesionales</span>
                        </div>
                    </button>
                </div>
            </div>

            <!-- 3. Chats (Acceso directo con badge) -->
            <button type="button" class="modern-nav-btn" data-tab="chats" onclick="switchTab('chats')">
                <span class="btn-icon">💬</span>
                <span class="btn-text">Chats</span>
                <span class="badge-red" id="chatsHandoffBadge" style="display: none;">!</span>
            </button>

            <!-- 4. Clientes (Acceso directo) -->
            <button type="button" class="modern-nav-btn" data-tab="customers" onclick="switchTab('customers')">
                <span class="btn-icon">👥</span>
                <span class="btn-text">Clientes</span>
            </button>

            <!-- 5. Ajustes (Dropdown Desplegable Flotante Moderno) -->
            <div class="nav-dropdown" id="dropdownSettings">
                <button type="button" class="modern-nav-btn dropdown-trigger" id="triggerSettings" onclick="toggleNavDropdown('dropdownSettings', event)">
                    <span class="btn-icon">⚙️</span>
                    <span class="btn-text">Ajustes</span>
                    <span class="dropdown-arrow">▾</span>
                </button>
                <div class="dropdown-panel dropdown-panel-right">
                    <div class="dropdown-panel-header">CONFIGURACIÓN DEL SISTEMA</div>
                    
                    <button type="button" class="dropdown-item" data-tab="settings" onclick="selectDropdownOption('settings', 'dropdownSettings')">
                        <span class="dropdown-item-icon">⚙️</span>
                        <div class="dropdown-item-content">
                            <span class="dropdown-item-name">Bot y Local</span>
                            <span class="dropdown-item-sub">Prompts de IA, horarios y datos</span>
                        </div>
                    </button>
                    
                    <button type="button" class="dropdown-item" data-tab="drivers" onclick="selectDropdownOption('drivers', 'dropdownSettings')">
                        <span class="dropdown-item-icon">🛵</span>
                        <div class="dropdown-item-content">
                            <span class="dropdown-item-name">Repartidores</span>
                            <span class="dropdown-item-sub">Gestión de delivery y tarifas</span>
                        </div>
                    </button>
                    
                    <button type="button" class="dropdown-item" data-tab="whatsapp" onclick="selectDropdownOption('whatsapp', 'dropdownSettings')">
                        <span class="dropdown-item-icon">📱</span>
                        <div class="dropdown-item-content">
                            <span class="dropdown-item-name">Conexión WhatsApp</span>
                            <span class="dropdown-item-sub">Código QR y Meta Cloud API</span>
                        </div>
                    </button>
                    
                    <button type="button" class="dropdown-item" data-tab="sheets" onclick="selectDropdownOption('sheets', 'dropdownSettings')">
                        <span class="dropdown-item-icon">📑</span>
                        <div class="dropdown-item-content">
                            <span class="dropdown-item-name">Google Sheets</span>
                            <span class="dropdown-item-sub">Sincronización de catálogo en la nube</span>
                        </div>
                    </button>
                    
                    <button type="button" class="dropdown-item" data-tab="excel" onclick="selectDropdownOption('excel', 'dropdownSettings')">
                        <span class="dropdown-item-icon">📊</span>
                        <div class="dropdown-item-content">
                            <span class="dropdown-item-name">Excel (Import / Export)</span>
                            <span class="dropdown-item-sub">Planillas .xlsx y .csv</span>
                        </div>
                    </button>
                    
                    <button type="button" class="dropdown-item" data-tab="database" onclick="selectDropdownOption('database', 'dropdownSettings')">
                        <span class="dropdown-item-icon">🗄️</span>
                        <div class="dropdown-item-content">
                            <span class="dropdown-item-name">Base de Datos Externa</span>
                            <span class="dropdown-item-sub">Conexión MySQL / PostgreSQL</span>
                        </div>
                    </button>
                    
                    <div class="dropdown-divider"></div>
                    
                    <button type="button" class="dropdown-item" data-tab="history" onclick="selectDropdownOption('history', 'dropdownSettings')">
                        <span class="dropdown-item-icon">📜</span>
                        <div class="dropdown-item-content">
                            <span class="dropdown-item-name">Historial de Pedidos</span>
                            <span class="dropdown-item-sub">Auditoría y pedidos pasados</span>
                        </div>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Tab: Productos -->
        <section class="tab-content active" id="tab-products">
            <div class="form-card">
                <h3 id="formTitle-products">➕ Nuevo Producto</h3>
                <form id="productForm" onsubmit="saveProduct(event, false)">
                    <input type="hidden" id="productId" value="">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="productName">Nombre</label>
                            <input type="text" id="productName" placeholder="Pizza Muzzarella" required>
                        </div>
                        <div class="form-group">
                            <label for="productPrice">Precio ($)</label>
                            <input type="number" id="productPrice" placeholder="350" step="0.01" required>
                        </div>
                        <div class="form-group">
                            <label for="productCategory">Categoría</label>
                            <input type="text" id="productCategory" list="categoryOptions" placeholder="Ej: Pizzas, Bebidas..." required>
                            <datalist id="categoryOptions"></datalist>
                        </div>
                        <div class="form-group full-width">
                            <label for="productDescription">Descripción</label>
                            <input type="text" id="productDescription" placeholder="Clásica con muzzarella y salsa de tomate">
                        </div>
                        <div class="form-group full-width">
                            <label for="productImage">Imagen del Producto (para enviar por WhatsApp)</label>
                            <input type="file" id="productImage" accept="image/*">
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn-primary" id="submitBtn-products">Guardar</button>
                        <button type="button" class="btn-secondary" onclick="resetForm(false)">Cancelar</button>
                    </div>
                </form>
            </div>
            <div class="products-list" id="productsList">
                <div class="loading">Cargando productos...</div>
            </div>
        </section>

        <!-- Tab: Doctores (Modo Clínica) -->
        <section class="tab-content" id="tab-doctors">
            <div class="form-card">
                <h3>➕ Agregar Profesional / Doctor</h3>
                <form id="doctorForm" onsubmit="saveDoctor(event)">
                    <input type="hidden" id="doctorId" value="">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="docName">Nombre del Profesional *</label>
                            <input type="text" id="docName" placeholder="Ej: Dr. Juan Pérez" required>
                        </div>
                        <div class="form-group">
                            <label for="docSpecialty">Especialidad</label>
                            <input type="text" id="docSpecialty" placeholder="Ej: Odontología, Medicina General">
                        </div>
                    <div class="form-actions">
                        <button type="submit" class="btn-primary">Guardar Profesional</button>
                        <button type="button" class="btn-secondary" onclick="resetDoctorForm()">Cancelar</button>
                    </div>
                </form>
            </div>

            <div class="card mt-md">
                <h3>👨‍⚕️ Profesionales Registrados</h3>
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Especialidad</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="doctorsTableBody">
                            <tr><td colspan="4" style="text-align:center">Cargando doctores...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Tab: Servicios (Modo Clínica) -->
        <section class="tab-content" id="tab-services">
            <div class="form-card">
                <h3 id="formTitle-services">➕ Nuevo Servicio</h3>
                <form id="serviceForm" onsubmit="saveProduct(event, true)">
                    <input type="hidden" id="serviceId" value="">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="serviceName">Nombre del Servicio</label>
                            <input type="text" id="serviceName" placeholder="Consulta General" required>
                        </div>
                        <div class="form-group">
                            <label for="servicePrice">Precio ($)</label>
                            <input type="number" id="servicePrice" placeholder="1500" step="0.01" required>
                        </div>
                        <div class="form-group">
                            <label for="serviceDuration">Duración (minutos)</label>
                            <input type="number" id="serviceDuration" placeholder="30" min="5" step="5" required>
                        </div>
                        <div class="form-group full-width">
                            <label for="serviceDescription">Descripción</label>
                            <input type="text" id="serviceDescription" placeholder="Evaluación primaria">
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn-primary" id="submitBtn-services">Guardar</button>
                        <button type="button" class="btn-secondary" onclick="resetForm(true)">Cancelar</button>
                    </div>
                </form>
            </div>
            <div class="products-list" id="servicesList">
                <div class="loading">Cargando servicios...</div>
            </div>
        </section>

        <!-- Tab: Citas (Modo Clínica) -->
        <section class="tab-content" id="tab-appointments" style="flex-direction: column; height: calc(100vh - 100px); margin: -20px; padding: 20px; box-sizing: border-box;">
            <!-- Controles superiores -->
            <div class="filter-bar">
                <h3 style="margin: 0; font-size: 1.5rem; font-weight: 700; color: var(--text-primary);">📅 Agenda</h3>
                
                <div class="filter-group">
                    <input type="date" id="appointmentDateFilter" onchange="filterAppointments()" class="filter-control">
                    <select id="appointmentStatusFilter" onchange="filterAppointments()" class="filter-control">
                        <option value="">Todos los estados</option>
                        <option value="pending">Pendientes</option>
                        <option value="confirmed">Confirmadas</option>
                        <option value="completed">Completadas</option>
                        <option value="cancelled">Canceladas</option>
                    </select>
                    <button class="btn-primary" onclick="showNewAppointmentForm()">➕ Nueva Cita</button>
                </div>
            </div>

            <!-- Calendario FullCalendar (Toma el resto del espacio) -->
            <div id="appointmentsCalendar" class="premium-calendar" style="flex: 1; min-height: 0;"></div>

            <!-- Formulario nueva cita (oculto por defecto) -->
            <div class="form-card" id="newAppointmentForm" style="display: none;">
                <h3 id="aptFormTitle">➕ Nueva Cita</h3>
                <form id="appointmentForm" onsubmit="saveAppointment(event)">
                    <input type="hidden" id="appointmentId" value="">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="aptCustomerPhone">Teléfono del Paciente *</label>
                            <input type="text" id="aptCustomerPhone" placeholder="+59899000000" required>
                        </div>
                        <div class="form-group">
                            <label for="aptCustomerName">Nombre del Paciente</label>
                            <input type="text" id="aptCustomerName" placeholder="Juan Pérez">
                        </div>
                        <div class="form-group">
                            <label for="aptService">Servicio *</label>
                            <select id="aptService" class="form-control" required>
                                <option value="">Seleccionar servicio...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="aptDoctor">Profesional / Doctor</label>
                            <select id="aptDoctor" class="form-control">
                                <option value="">Sin preferencia / Cualquier doctor</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="aptDate">Fecha *</label>
                            <input type="date" id="aptDate" required onchange="loadAvailableSlots()">
                        </div>
                        <div class="form-group">
                            <label for="aptTime">Hora *</label>
                            <select id="aptTime" class="form-control" required>
                                <option value="">Seleccionar hora...</option>
                            </select>
                        </div>
                        <div class="form-group full-width">
                            <label for="aptNotes">Notas / Motivo de consulta</label>
                            <textarea id="aptNotes" rows="3" placeholder="Motivo de la consulta, observaciones..." class="form-control" style="resize: vertical;"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn-primary" id="aptSubmitBtn">Guardar Cita</button>
                        <button type="button" class="btn-secondary" onclick="resetAppointmentForm()">Cancelar</button>
                    </div>
                </form>
            </div>
        </section>

        <!-- Tab: Habitaciones (Modo Hostel) -->
        <section class="tab-content" id="tab-rooms">
            <div class="form-card">
                <h3 id="formTitle-rooms">➕ Nueva Habitación / Dormitorio</h3>
                <form id="roomForm" onsubmit="saveRoom(event)">
                    <input type="hidden" id="roomId" value="">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="roomName">Nombre de Habitación/Dorm *</label>
                            <input type="text" id="roomName" placeholder="Dormitorio 6 Camas Mixto" required>
                        </div>
                        <div class="form-group">
                            <div class="flex-between" style="margin-bottom: 6px;">
                                <label for="roomType" style="margin-bottom:0;">Tipo *</label>
                                <button type="button" onclick="openRoomTypesModal()" class="btn-secondary" style="padding: 2px 8px; font-size: 0.8rem; cursor: pointer;">⚙️ Gestionar Tipos</button>
                            </div>
                            <select id="roomType" class="form-control">
                                <option value="shared_dorm">Dormitorio Compartido (Camas)</option>
                                <option value="private">Habitación Privada</option>
                                <option value="suite">Suite Especial</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="roomPrice">Precio por Noche *</label>
                            <input type="number" step="0.01" id="roomPrice" placeholder="25.00" required>
                        </div>
                        <div class="form-group">
                            <label for="roomCapacity">Capacidad Máxima (personas)</label>
                            <input type="number" id="roomCapacity" placeholder="6" value="1">
                        </div>
                        <div class="form-group">
                            <label for="roomTotalUnits">Unidades / Camas Totales</label>
                            <input type="number" id="roomTotalUnits" placeholder="6" value="1">
                        </div>
                        <div class="form-group full-width">
                            <label for="roomDescription">Descripción / Amenidades</label>
                            <input type="text" id="roomDescription" placeholder="Aire acondicionado, lockers individuales, baño en suite">
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn-primary" id="btnSaveRoom">Guardar Habitación</button>
                        <button type="button" class="btn-secondary" onclick="resetRoomForm()">Cancelar</button>
                    </div>
                </form>
            </div>

            <div class="table-card">
                <h3>🛏️ Inventario de Habitaciones</h3>
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Tipo</th>
                                <th>Precio/Noche</th>
                                <th>Capacidad</th>
                                <th>Unidades</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="roomsTableBody">
                            <tr><td colspan="6" style="text-align:center">Cargando habitaciones...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Tab: Reservas (Modo Hostel) -->
        <section class="tab-content" id="tab-bookings">
            <div class="filter-bar">
                <h3 style="margin: 0; font-size: 1.5rem; font-weight: 700; color: var(--text-primary);">🏨 Reservas del Hostel</h3>
                
                <div class="filter-group">
                    <select id="bookingStatusFilter" onchange="loadBookings()" class="filter-control">
                        <option value="">Todos los estados</option>
                        <option value="pending">Pendientes</option>
                        <option value="confirmed">Confirmadas</option>
                        <option value="checked_in">Checked-In</option>
                        <option value="checked_out">Checked-Out</option>
                        <option value="cancelled">Canceladas</option>
                    </select>
                    <button class="btn-primary" onclick="showNewBookingModal()">➕ Nueva Reserva Manual</button>
                </div>
            </div>

            <div class="table-card">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Nº Reserva</th>
                                <th>Huésped</th>
                                <th>Teléfono</th>
                                <th>Habitación</th>
                                <th>Check-In</th>
                                <th>Check-Out</th>
                                <th>Huéspedes</th>
                                <th>Total</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="bookingsTableBody">
                            <tr><td colspan="10" style="text-align:center">Cargando reservas...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Modal Nueva Reserva Manual -->
            <div id="newBookingModal" class="modal-overlay">
                <div class="form-card modal-card">
                    <h3 style="margin-top: 0;">➕ Nueva Reserva Manual</h3>
