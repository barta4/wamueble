<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/landing.css">
</head>
<body class="landing-body">
    <!-- Navbar -->
    <nav class="landing-nav">
        <div class="nav-container">
            <div class="nav-logo">
                <img src="/images/logo.png" alt="UruBot" class="logo-img" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 100 100\'><circle cx=\'50\' cy=\'50\' r=\'50\' fill=\'%2310b981\'/><path d=\'M30 50 L45 65 L70 35\' stroke=\'white\' stroke-width=\'10\' fill=\'none\'/></svg>'">
            </div>
            <div class="nav-links">
                <a href="#features">Features</a>
                <a href="#how-it-works">Cómo Funciona</a>
                <a href="#pricing">Precios</a>
                <a href="/login" class="nav-btn-login">Iniciar Sesión</a>
                <a href="/register" class="nav-btn-register">Empezar Gratis</a>
            </div>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero-section">
        <div class="hero-content">
            <div class="hero-badge">🤖 IA Especializada en Ventas</div>
            <h1 class="hero-title">
                Nunca más pierdas un pedido de WhatsApp.
                <span class="hero-highlight">La IA que vende por vos las 24 horas.</span>
            </h1>
            <p class="hero-subtitle">
                Atiende a cientos de clientes a la vez, toma pedidos, gestiona turnos y coordina envíos en tiempo real. Configuralo en 5 minutos y dejá que UruBot haga crecer tu negocio.
            </p>
            <div class="hero-cta">
                <a href="/register" class="btn-primary btn-lg">Empezar Gratis →</a>
                <a href="#features" class="btn-secondary btn-lg">Ver Demo</a>
            </div>
            <p class="hero-note">Sin tarjeta de crédito requerida • Cancela en cualquier momento</p>
        </div>
        
        <div class="hero-visual">
            <div class="connection-line"></div>
            
            <div class="abstract-phone">
                <div class="phone-notch"></div>
                <div class="chat-bubble bot b1">¡Hola! Bienvenido. ¿Qué te gustaría pedir?</div>
                <div class="chat-bubble user b2">Quiero 2 pizzas muzzarella</div>
                <div class="chat-bubble bot b3">Perfecto. ¿Para retirar o envío?</div>
                <div class="chat-bubble user b4">Envío a Av. 18 de Julio 1234</div>
            </div>

            <div class="abstract-dashboard">
                <div class="dash-header"></div>
                <div class="dash-row">
                    <div class="dash-col">🍔 Pedido 1045</div>
                    <div class="dash-col">🛵 Repartidor</div>
                </div>
                <div class="dash-list">
                    <div class="dash-item green"></div>
                    <div class="dash-item"></div>
                    <div class="dash-item"></div>
                </div>
                <div class="dash-row" style="margin-top: 10px;">
                    <div class="dash-item" style="flex: 2;"></div>
                    <div class="dash-item green" style="flex: 1;"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Metrics -->
    <section class="metrics-section">
        <div class="metrics-grid">
            <div class="metric-item">
                <h4>24/7</h4>
                <p>Atención ininterrumpida</p>
            </div>
            <div class="metric-item">
                <h4>< 2s</h4>
                <p>Tiempo de respuesta</p>
            </div>
            <div class="metric-item">
                <h4>100%</h4>
                <p>Automatización de pedidos</p>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section class="features-section" id="features">
        <div class="section-container">
            <h2 class="section-title">Todo lo que necesitás para escalar</h2>
            <p class="section-subtitle">Diseñado para restaurantes, clínicas y comercios que buscan máxima eficiencia sin sacrificar calidad de atención.</p>
            
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">🧠</div>
                    <h3>IA que entiende contexto</h3>
                    <p>Procesa texto, audio e imágenes. Maneja modismos locales y toma decisiones inteligentes basándose en tu catálogo.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📱</div>
                    <h3>Integración Nativa WhatsApp</h3>
                    <p>Tus clientes no tienen que descargar nada. Vendes directamente donde ellos ya pasan su tiempo.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🍳</div>
                    <h3>Dashboard en Tiempo Real</h3>
                    <p>Monitoreo en vivo de pedidos y citas. Alertas sonoras para la cocina y gestión fluida de estados.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🛵</div>
                    <h3>Logística Automatizada</h3>
                    <p>Cálculo de distancias, asignación de repartidores y notificaciones automáticas cuando el pedido está en camino.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📊</div>
                    <h3>Reportes Avanzados</h3>
                    <p>Métricas detalladas de ventas, rendimiento por método de pago, cierres de caja y estadísticas de envíos.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">⚡</div>
                    <h3>Handoff a Humano</h3>
                    <p>Si la conversación requiere un trato especial, la IA te alerta y transfiere el chat para que intervengas en tiempo real.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- How it works -->
    <section class="how-section" id="how-it-works">
        <div class="section-container">
            <h2 class="section-title">¿Cómo funciona?</h2>
            <p class="section-subtitle">En menos de 10 minutos estarás vendiendo automáticamente</p>
            
            <div class="steps-grid">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h3>Creá tu cuenta</h3>
                    <p>Registrate e ingresá la información básica de tu comercio, horarios y preferencias de IA.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">2</div>
                    <h3>Subí tu catálogo</h3>
                    <p>Agrega tus productos o servicios con precios y descripciones para que la IA sepa qué vender.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">3</div>
                    <h3>Conectá WhatsApp</h3>
                    <p>Escaneá un código QR desde tu celular o conecta Meta Cloud API con un clic.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">4</div>
                    <h3>Automatizá</h3>
                    <p>La IA empieza a responder, tú solo miras el dashboard y gestionas entregas o citas.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Pricing -->
    <section class="pricing-section" id="pricing">
        <div class="section-container">
            <h2 class="section-title">Planes simples y transparentes</h2>
            <p class="section-subtitle">Empieza gratis, escala a medida que crece tu facturación.</p>
            
            <div class="pricing-grid">
                <% if (typeof plans !== 'undefined' && plans.length > 0) { %>
                    <% plans.forEach((plan, index) => { %>
                        <% const isPopular = index === 1; %>
                        <div class="pricing-card <%= isPopular ? 'popular' : '' %>">
                            <% if (isPopular) { %>
                                <div class="popular-badge">Más Elegido</div>
                            <% } %>
                            <div class="pricing-header">
                                <h3>Plan <%= plan.name %></h3>
                                <div class="price">$<%= plan.price %><span>/<%= plan.interval === 'year' ? 'año' : 'mes' %></span></div>
                                <p><%= plan.description %></p>
                            </div>
                            <ul class="pricing-features">
                                <% 
                                let featuresList = [];
                                try { featuresList = JSON.parse(plan.features); } catch(e) {}
                                featuresList.forEach(feat => { 
                                %>
                                    <li><%= feat %></li>
                                <% }) %>
                            </ul>
                            <a href="/register" class="<%= isPopular ? 'btn-primary' : 'btn-secondary' %> btn-lg">
                                <%= plan.price === 0 ? 'Crear Cuenta Gratis' : 'Comenzar Prueba ' + plan.name %>
                            </a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p style="text-align: center; color: var(--text-secondary); width: 100%;">No hay planes configurados en este momento.</p>
                <% } %>
            </div>
        </div>
    </section>

    <footer class="landing-footer">
        <p>© 2026 UruBot SaaS. Todos los derechos reservados.</p>
        <p style="margin-top: 10px; font-size: 0.9rem;">Plataforma desarrollada para revolucionar las ventas por WhatsApp.</p>
    </footer>
</body>
</html>
